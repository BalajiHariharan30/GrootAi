# GrootAi — Environment Variables
# Copy this file to .env and fill in the values

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (Optional — auto-falls-back to zero-config in-memory store) ─
MONGODB_URI=mongodb://127.0.0.1:27017/grootai

# ── Cache (Optional — auto-falls-back to in-memory cache) ─────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── AI Reasoning Engine (Optional — falls back to Grounded AST parser) ────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google OAuth 2.0 (REQUIRED for Google Sign-In) ────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── JWT Session ───────────────────────────────────────────────────────────
# Use a random 32+ character secret in production (e.g. openssl rand -base64 32)
JWT_SECRET=grootai-dev-secret-change-this-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# ── Frontend URL (used for OAuth redirects) ───────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
