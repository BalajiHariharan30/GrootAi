{
  "name": "grootai-server",
  "version": "1.0.0",
  "description": "GrootAi - Agentic Data Quality Platform Server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "eval": "node tests/eval/runEval.js",
    "test": "node --test tests/unit/**/*.test.js",
    "lint": "eslint src --ext .js --report-unused-disable-directives --max-warnings 10",
    "format": "prettier --write src"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "natural": "^6.10.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.7.5",
    "winston": "3.19.0"
  }
}
